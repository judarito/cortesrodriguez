{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cortes-rodriguez-asesores",
	"main": "worker/index.js",
	"triggers": { "crons": ["* * * * *"] },
	"queues": {
		"producers": [{ "binding": "NOTIFICATION_EVENTS_QUEUE", "queue": "cra-notification-events" }],
		"consumers": [{
			"queue": "cra-notification-events",
			"max_batch_size": 10,
			"max_batch_timeout": 5,
			"max_retries": 5,
			"retry_delay": 60,
			"dead_letter_queue": "cra-notification-events-dlq",
			"max_concurrency": 5
		}]
	},
	"compatibility_date": "2026-05-13",
	"flagship": [
		{
			"binding": "LANDING_FLAGS",
			"app_id": "dacec36c-be99-416b-b1ac-a27abb404a68"
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"r2_buckets": [
		{
			"binding": "GALLERY_IMAGES",
			"bucket_name": "cortes-rodriguez-asesores-images"
		},
		{
			"bucket_name": "cortes-rodriguez-asesores-images",
			"binding": "cortes_rodriguez_asesores_images",
			"remote": true
		}
	]
}
