{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cortes-rodriguez-asesores-dev",
  "main": "worker/index.js",
  "durable_objects": { "bindings": [{ "name": "APP_NOTIFICATION_HUB", "class_name": "NotificationHub" }] },
  "migrations": [{ "tag": "notifications-hub-v1", "new_sqlite_classes": ["NotificationHub"] }],
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "NOTIFICATION_EVENTS_QUEUE", "queue": "cra-notification-events-dev" }],
    "consumers": [{
      "queue": "cra-notification-events-dev",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 5,
      "retry_delay": 60,
      "dead_letter_queue": "cra-notification-events-dev-dlq",
      "max_concurrency": 5
    }]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "compatibility_date": "2026-05-13",
  "flagship": [
    {
      "binding": "LANDING_FLAGS",
      "app_id": "aabdeecf-cb37-4656-8ef0-d4bcfec436e9"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "GALLERY_IMAGES",
      "bucket_name": "cortes-rodriguez-asesores-images-dev"
    }
  ]
}
